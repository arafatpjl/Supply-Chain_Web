@model PurchaseOrderIndexViewModel
@{ ViewData["Title"] = "Purchase Orders"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Purchase Orders</h1>
        <small class="text-body-secondary">
            Replaces <code>frmProformaInvoice.frm</code> and <code>frmProformaInvoiceOC.frm</code>
        </small>
    </div>
    <a class="btn btn-primary" asp-action="Create">New Purchase Order</a>
</div>

<div class="alert alert-light border small d-flex align-items-start gap-2">
    <span>ℹ️</span>
    <div>
        Two VB6 forms, ~85% identical, are now one. Diffing them first showed the split had
        <strong>no currency handling difference at all</strong> &mdash; both stored a currency per
        line and neither held an exchange rate. See
        <code>docs/analysis/po-currency-variant-diff.md</code>.
    </div>
</div>

<form method="get" asp-action="Index" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <input type="search" name="search" value="@Model.SearchTerm" class="form-control"
                   placeholder="P.O. number or supplier" aria-label="Search" />
        </div>
        <div class="col-auto">
            <select name="supplierId" class="form-select" aria-label="Filter by supplier">
                <option value="">All suppliers</option>
                @foreach (var supplier in Model.Suppliers)
                {
                    <option value="@supplier.Id" selected="@(supplier.Id == Model.SupplierId)">@supplier.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.SupplierId.HasValue)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </div>
</form>

<div class="card">
    <div class="sc-grid-wrapper">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">P.O. No</th>
                    <th scope="col">Supplier</th>
                    <th scope="col">P.O. Date</th>
                    <th scope="col">Period</th>
                    <th scope="col" class="sc-numeric">Lines</th>
                    <th scope="col" class="sc-numeric">Total</th>
                    <th scope="col" class="text-end" style="width: 14rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Results.Items.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-body-secondary py-4">No Data found !</td></tr>
                }
                else
                {
                    @foreach (var order in Model.Results.Items)
                    {
                        <tr>
                            <td><code>@order.Number</code></td>
                            <td>@order.SupplierName</td>
                            <td>@order.OrderDate.ToString("dd-MMM-yyyy")</td>
                            <td class="text-body-secondary">
                                @if (order.FromDate is not null || order.ToDate is not null)
                                {
                                    @($"{order.FromDate?.ToString("dd-MMM-yyyy") ?? "—"} to {order.ToDate?.ToString("dd-MMM-yyyy") ?? "—"}")
                                }
                                else
                                {
                                    <span>&mdash;</span>
                                }
                            </td>
                            <td class="sc-numeric">@order.LineCount</td>
                            <td class="sc-numeric">@order.Total.ToString("N2") @order.Currency</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@order.Id">View</a>
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@order.Id">Edit</a>
                                <form method="post" class="d-inline" asp-action="Delete" asp-route-id="@order.Id"
                                      onsubmit="return confirm('Are you sure to Delete?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <partial name="_Pager" model="@(new PagerViewModel
                                        {
                                            PageNumber = Model.Results.PageNumber,
                                            TotalPages = Model.Results.TotalPages,
                                            TotalCount = Model.Results.TotalCount,
                                            BasePath = Url.Action("Index")!,
                                            RouteValues = new Dictionary<string, string?>
                                            {
                                                ["search"] = Model.SearchTerm,
                                                ["supplierId"] = Model.SupplierId?.ToString(),
                                            },
                                        })" />
    </div>
</div>
