@model PurchaseOrderFormViewModel
@using SupplyChain.Domain.Enums
@{ ViewData["Title"] = Model.IsEdit ? $"Edit P.O. {Model.Number}" : "New Purchase Order"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">@ViewData["Title"]</h1>
        @if (Model.IsEdit)
        {
            <small class="text-body-secondary">
                The document number is issued once and never changes.
            </small>
        }
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">Close</a>
</div>

<form method="post" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" id="poForm">
    <div asp-validation-summary="All" class="alert alert-danger d-none-if-empty"></div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="SupplierId" class="form-label"></label>
                    <select asp-for="SupplierId" class="form-select">
                        <option value="">— Select —</option>
                        @foreach (var supplier in Model.Suppliers)
                        {
                            <option value="@supplier.Id" selected="@(supplier.Id == Model.SupplierId)">@supplier.Name</option>
                        }
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="OrderDate" class="form-label"></label>
                    <input asp-for="OrderDate" type="date" class="form-control" />
                    <span asp-validation-for="OrderDate" class="text-danger small"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="FromDate" class="form-label"></label>
                    <input asp-for="FromDate" type="date" class="form-control" />
                </div>

                <div class="col-md-2">
                    <label asp-for="ToDate" class="form-label"></label>
                    <input asp-for="ToDate" type="date" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    @*
        The line editor replaces the MSFlexGrid the legacy forms used. Rows are added and removed
        client-side and posted as a collection, so the whole order is one request and one
        transaction — the legacy form saved the header and each line separately, untransacted.
    *@
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span class="fw-semibold">Items</span>
            <button type="button" class="btn btn-sm btn-outline-primary" id="addLine">Add Item</button>
        </div>

        <div class="sc-grid-wrapper">
            <table class="table table-sm mb-0 align-middle" id="lineTable">
                <thead>
                    <tr>
                        <th scope="col" style="min-width: 12rem;">Item</th>
                        <th scope="col" style="min-width: 10rem;">Description</th>
                        <th scope="col" style="min-width: 7rem;">PR No.</th>
                        <th scope="col" style="min-width: 6rem;">Qty</th>
                        <th scope="col" style="min-width: 5rem;">Unit</th>
                        <th scope="col" style="min-width: 7rem;">Unit Price</th>
                        <th scope="col" style="min-width: 6rem;">Currency</th>
                        <th scope="col" style="min-width: 8rem;">Condition</th>
                        <th scope="col" class="sc-numeric" style="min-width: 7rem;">Total</th>
                        <th scope="col" style="width: 3rem;"></th>
                    </tr>
                </thead>
                <tbody id="lineBody">
                    @for (var i = 0; i < Model.Lines.Count; i++)
                    {
                        <tr class="po-line">
                            <td>
                                <select name="Lines[@i].ItemId" class="form-select form-select-sm">
                                    <option value="">— Select —</option>
                                    @foreach (var item in Model.Items)
                                    {
                                        <option value="@item.Id" selected="@(item.Id == Model.Lines[i].ItemId)">@item.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Lines[@i].Description" value="@Model.Lines[i].Description" class="form-control form-control-sm" /></td>
                            <td><input name="Lines[@i].PrNo" value="@Model.Lines[i].PrNo" class="form-control form-control-sm" /></td>
                            <td><input name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity" type="number" step="0.0001" class="form-control form-control-sm po-qty" /></td>
                            <td><input name="Lines[@i].QtyUnit" value="@Model.Lines[i].QtyUnit" class="form-control form-control-sm" /></td>
                            <td><input name="Lines[@i].UnitPrice" value="@Model.Lines[i].UnitPrice" type="number" step="0.0001" class="form-control form-control-sm po-price" /></td>
                            <td>
                                <select name="Lines[@i].Currency" class="form-select form-select-sm">
                                    @foreach (var currency in Enum.GetValues<CurrencyCode>())
                                    {
                                        <option value="@currency" selected="@(currency == Model.Lines[i].Currency)">@currency</option>
                                    }
                                </select>
                            </td>
                            <td><input name="Lines[@i].Condition" value="@Model.Lines[i].Condition" class="form-control form-control-sm" /></td>
                            <td class="sc-numeric po-total">0.00</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger po-remove" aria-label="Remove line">&times;</button>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-semibold border-top">
                        <td colspan="8" class="text-end">Total</td>
                        <td class="sc-numeric" id="grandTotal">0.00</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="card-footer d-flex gap-2">
            <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Update" : "Save")</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Close</a>
        </div>
    </div>
</form>

@* Template for a new row. Rendered once, cloned by the line editor. *@
<template id="lineTemplate">
    <tr class="po-line">
        <td>
            <select name="Lines[__i__].ItemId" class="form-select form-select-sm">
                <option value="">— Select —</option>
                @foreach (var item in Model.Items)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </select>
        </td>
        <td><input name="Lines[__i__].Description" class="form-control form-control-sm" /></td>
        <td><input name="Lines[__i__].PrNo" class="form-control form-control-sm" /></td>
        <td><input name="Lines[__i__].Quantity" type="number" step="0.0001" class="form-control form-control-sm po-qty" /></td>
        <td><input name="Lines[__i__].QtyUnit" class="form-control form-control-sm" /></td>
        <td><input name="Lines[__i__].UnitPrice" type="number" step="0.0001" class="form-control form-control-sm po-price" /></td>
        <td>
            <select name="Lines[__i__].Currency" class="form-select form-select-sm">
                @foreach (var currency in Enum.GetValues<CurrencyCode>())
                {
                    <option value="@currency">@currency</option>
                }
            </select>
        </td>
        <td><input name="Lines[__i__].Condition" class="form-control form-control-sm" /></td>
        <td class="sc-numeric po-total">0.00</td>
        <td>
            <button type="button" class="btn btn-sm btn-outline-danger po-remove" aria-label="Remove line">&times;</button>
        </td>
    </tr>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/line-editor.js" asp-append-version="true"></script>
}
