@model PartyStatementViewModel
@using SupplyChain.Application.Reports.PartyStatement
@using SupplyChain.Domain.Enums
@using SupplyChain.Web.Reporting
@{ ViewData["Title"] = "Party Statement"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Party Statement</h1>
        <small class="text-body-secondary">Replaces <code>frmrptPartyStatement.frm</code></small>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Index">All Reports</a>
</div>

<form method="get" asp-action="PartyStatement" class="card mb-3">
    <div class="card-body">
        <input type="hidden" asp-for="HasRun" value="true" />

        <div class="row g-3 align-items-end">
            <div class="col-sm-6 col-lg-3">
                <label asp-for="SupplierId" class="form-label"></label>
                <select asp-for="SupplierId" class="form-select">
                    <option value="">All Parties</option>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <option value="@supplier.Id" selected="@(Model.SupplierId == supplier.Id)">@supplier.Name</option>
                    }
                </select>
            </div>

            <div class="col-sm-6 col-lg-2">
                <label asp-for="DateBasis" class="form-label"></label>
                <select asp-for="DateBasis" class="form-select">
                    <option value="@StatementDateBasis.TransactionDate"
                            selected="@(Model.DateBasis == StatementDateBasis.TransactionDate)">Transaction Date</option>
                    <option value="@StatementDateBasis.BillDate"
                            selected="@(Model.DateBasis == StatementDateBasis.BillDate)">Bill Date</option>
                </select>
            </div>

            <div class="col-sm-6 col-lg-2">
                <label asp-for="FromDate" class="form-label"></label>
                <input asp-for="FromDate" type="date" class="form-control" />
            </div>

            <div class="col-sm-6 col-lg-2">
                <label asp-for="ToDate" class="form-label"></label>
                <input asp-for="ToDate" type="date" class="form-control" />
            </div>

            <div class="col-sm-6 col-lg-2">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select">
                    <option value="">All Type</option>
                    @foreach (var type in Enum.GetValues<TransactionType>())
                    {
                        <option value="@type" selected="@(Model.Type == type)">
                            @TransactionStatementColumns.Describe(type)
                        </option>
                    }
                </select>
            </div>

            <div class="col-auto">
                <div class="form-check">
                    <input asp-for="Summary" class="form-check-input" />
                    <label asp-for="Summary" class="form-check-label"></label>
                </div>
                @if (Model.CanRunAllCompanies)
                {
                    <div class="form-check">
                        <input asp-for="AllCompanies" class="form-check-input" />
                        <label asp-for="AllCompanies" class="form-check-label"></label>
                    </div>
                }
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">Preview</button>
            </div>
        </div>
    </div>
</form>

@{
    var routeData = Context.Request.Query.ToDictionary(q => q.Key, q => q.Value.ToString());
}

@if (Model.HasRun && Model.Summary && Model.SummaryReport is { } summary)
{
    <partial name="_ReportHeader" model="@ReportHeaderViewModel.From(summary, Url.Action("PartyStatement")!, routeData)" />
    <div class="card">
        <div class="sc-grid-wrapper">
            <table class="table table-sm table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">Company</th>
                        <th scope="col">Party</th>
                        <th scope="col" class="sc-numeric">Entries</th>
                        <th scope="col" class="sc-numeric">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (summary.IsEmpty)
                    {
                        <tr><td colspan="4" class="text-center text-body-secondary py-4">No Data found !</td></tr>
                    }
                    else
                    {
                        @foreach (var row in summary.Rows)
                        {
                            <tr>
                                <td>@row.CompanyName</td>
                                <td>@row.PartyName</td>
                                <td class="sc-numeric">@row.EntryCount</td>
                                <td class="sc-numeric">@row.Amount.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (!summary.IsEmpty)
                {
                    <tfoot>
                        <tr class="fw-semibold border-top">
                            <td colspan="2" class="text-end">Total</td>
                            <td class="sc-numeric">@summary.Rows.Sum(r => r.EntryCount)</td>
                            <td class="sc-numeric">@summary.Rows.Sum(r => r.Amount).ToString("N2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}
else if (Model.HasRun && Model.Detail is { } detail)
{
    <partial name="_ReportHeader" model="@ReportHeaderViewModel.From(detail, Url.Action("PartyStatement")!, routeData)" />
    <div class="card">
        <div class="sc-grid-wrapper">
            <table class="table table-sm table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th scope="col">Party</th>
                        <th scope="col" class="sc-numeric">Stmt No</th>
                        <th scope="col" class="sc-numeric">Tr No</th>
                        <th scope="col">Type</th>
                        <th scope="col">Tran Date</th>
                        <th scope="col">Bill No</th>
                        <th scope="col">Bill Date</th>
                        <th scope="col">MRR No</th>
                        <th scope="col">Challan No</th>
                        <th scope="col">Remark</th>
                        <th scope="col" class="sc-numeric">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (detail.IsEmpty)
                    {
                        <tr><td colspan="11" class="text-center text-body-secondary py-4">No Data found !</td></tr>
                    }
                    else
                    {
                        @foreach (var row in detail.Rows)
                        {
                            <tr>
                                <td>@row.PartyName</td>
                                <td class="sc-numeric">@row.StatementNo</td>
                                <td class="sc-numeric">@row.TransactionNo</td>
                                <td>@TransactionStatementColumns.Describe(row.Type)</td>
                                <td>@row.TransactionDate.ToString("dd-MMM-yyyy")</td>
                                <td>@row.BillNo</td>
                                <td>@(row.BillDate?.ToString("dd-MMM-yyyy"))</td>
                                <td>@row.MrrNo</td>
                                <td>@row.ChallanNo</td>
                                <td>@row.Remark</td>
                                <td class="sc-numeric">@row.Amount.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (!detail.IsEmpty)
                {
                    <tfoot>
                        <tr class="fw-semibold border-top">
                            <td colspan="10" class="text-end">Total</td>
                            <td class="sc-numeric">@detail.Rows.Sum(r => r.Amount).ToString("N2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
}
