@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }

<div class="row">
    <div class="col-md-6 col-lg-5">
        <h1 class="h4 mb-1">Reset Password</h1>
        <p class="text-body-secondary">for <code>@Model.UserName</code></p>

        <div class="card">
            <div class="card-body">
                <form method="post" asp-action="ResetPassword" asp-route-id="@Model.Id">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger d-none-if-empty"></div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autofocus autocomplete="new-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Set Password</button>
                        <a class="btn btn-outline-secondary" asp-action="Index">Close</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
