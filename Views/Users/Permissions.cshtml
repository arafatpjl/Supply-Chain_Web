@model UserPermissionsViewModel
@{ ViewData["Title"] = "Permissions"; }

<h1 class="h4 mb-1">Permissions</h1>
<p class="text-body-secondary">for <code>@Model.UserName</code></p>

@* Provenance: the legacy screen edited a three-level menu tree across Sys_User_MM / MS / MSS. *@
<div class="alert alert-light border small d-flex align-items-start gap-2">
    <span>ℹ️</span>
    <div>
        Replaces <code>frmPermissionMenu.frm</code>, which granted access per <em>menu item</em>
        across three nested levels and enforced it by hiding menus. Permissions are now checked on
        the endpoint, so a hidden link is a courtesy rather than the control.
        <br />
        A permission supplied by a role is shown as such; ticking it here grants it directly as well.
    </div>
</div>

<form method="post" asp-action="Permissions" asp-route-id="@Model.Id">
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var module in Model.Grants)
        {
            <div class="col">
                <div class="card h-100">
                    <div class="card-header text-capitalize fw-semibold">@module.Key</div>
                    <div class="card-body">
                        @foreach (var grant in module.OrderBy(g => g.Name))
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="SelectedPermissions"
                                       value="@grant.Name" id="perm-@grant.Name"
                                       checked="@grant.IsGranted" />
                                <label class="form-check-label" for="perm-@grant.Name">
                                    <code>@grant.Name</code>
                                    @if (grant.GrantedByRole is not null)
                                    {
                                        <span class="badge text-bg-info ms-1"
                                              title="Granted by the @grant.GrantedByRole role">via @grant.GrantedByRole</span>
                                    }
                                    @if (!grant.IsEnforced)
                                    {
                                        <span class="badge text-bg-warning ms-1"
                                              title="Assignable so migrated grants survive, but no endpoint checks it yet">not yet enforced</span>
                                    }
                                </label>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">Update</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Close</a>
    </div>
</form>
