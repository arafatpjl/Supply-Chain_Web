@model SupplierIndexViewModel
@{ ViewData["Title"] = "Suppliers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Suppliers</h1>
        <small class="text-body-secondary">Replaces <code>frmNewSupplier.frm</code></small>
    </div>
    <a class="btn btn-primary" asp-action="Create">New Supplier</a>
</div>

@* Provenance note: this is the clearest before/after in the migration, so it is worth stating
   on the screen itself for anyone reviewing the project. *@
<div class="alert alert-light border small d-flex align-items-start gap-2">
    <span>ℹ️</span>
    <div>
        In the VB6 application, saving one supplier executed <strong>seventeen sequential INSERT
        statements</strong> — one per company database, hardcoded and untransacted. Suppliers are
        now a single shared record.
    </div>
</div>

<form method="get" asp-action="Index" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-auto">
            <input type="search" name="search" value="@Model.SearchTerm" class="form-control"
                   placeholder="Search suppliers" aria-label="Search" />
        </div>
        <div class="col-auto">
            <select name="countryId" class="form-select" aria-label="Filter by country">
                <option value="">All countries</option>
                @foreach (var country in Model.Countries)
                {
                    <option value="@country.Id" selected="@(country.Id == Model.CountryId)">@country.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-secondary">Search</button>
            @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.CountryId.HasValue)
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </div>
</form>

<div class="card">
    <div class="sc-grid-wrapper">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">Name of Supplier</th>
                    <th scope="col">Address</th>
                    <th scope="col">Country</th>
                    <th scope="col" class="text-end" style="width: 12rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Results.Items.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-body-secondary py-4">No suppliers found.</td></tr>
                }
                else
                {
                    @foreach (var row in Model.Results.Items)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td class="text-body-secondary">@(row.Address ?? "—")</td>
                            <td class="text-body-secondary">@(row.CountryName ?? "—")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                                <form method="post" class="d-inline" asp-action="Delete" asp-route-id="@row.Id"
                                      onsubmit="return confirm('Are you sure to Delete?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <partial name="_Pager" model="@(new PagerViewModel
                                        {
                                            PageNumber = Model.Results.PageNumber,
                                            TotalPages = Model.Results.TotalPages,
                                            TotalCount = Model.Results.TotalCount,
                                            BasePath = Url.Action("Index")!,
                                            RouteValues = new Dictionary<string, string?>
                                            {
                                                ["search"] = Model.SearchTerm,
                                                ["countryId"] = Model.CountryId?.ToString(),
                                            },
                                        })" />
    </div>
</div>
