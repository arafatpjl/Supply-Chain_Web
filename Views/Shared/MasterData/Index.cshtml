@model NamedMasterDataIndexViewModel
@{
    ViewData["Title"] = Model.Descriptor.Title;
    var d = Model.Descriptor;
}
@*
    One list view serving four master-data screens. The legacy equivalents — frmNewCountry,
    frmNewPFNo, frmParty and frmNewAccountsHead — were four separate forms repeating the same
    grid, search box and button row.
*@

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">@d.Title</h1>
        <small class="text-body-secondary">Replaces <code>@d.LegacyForm</code></small>
    </div>
    <a class="btn btn-primary" asp-controller="@d.Controller" asp-action="Create">
        New @d.SingularTitle
    </a>
</div>

<form method="get" asp-controller="@d.Controller" asp-action="Index" class="mb-3">
    <div class="input-group" style="max-width: 28rem;">
        <input type="search" name="search" value="@Model.SearchTerm" class="form-control"
               placeholder="Search @d.Title.ToLowerInvariant()" aria-label="Search" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a class="btn btn-outline-secondary" asp-controller="@d.Controller" asp-action="Index">Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="sc-grid-wrapper">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">@d.NameLabel</th>
                    <th scope="col" class="text-end" style="width: 12rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Results.Items.Count == 0)
                {
                    <tr>
                        <td colspan="2" class="text-center text-body-secondary py-4">
                            No @d.Title.ToLowerInvariant() found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var row in Model.Results.Items)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary"
                                   asp-controller="@d.Controller" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                                <form method="post" class="d-inline"
                                      asp-controller="@d.Controller" asp-action="Delete" asp-route-id="@row.Id"
                                      onsubmit="return confirm('Are you sure to Delete?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <partial name="_Pager" model="@(new PagerViewModel
                                        {
                                            PageNumber = Model.Results.PageNumber,
                                            TotalPages = Model.Results.TotalPages,
                                            TotalCount = Model.Results.TotalCount,
                                            BasePath = Url.Action("Index", d.Controller)!,
                                            RouteValues = new Dictionary<string, string?> { ["search"] = Model.SearchTerm },
                                        })" />
    </div>
</div>
