@model ItemTypeIndexViewModel
@{ ViewData["Title"] = "Item Types"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h4 mb-0">Item Types</h1>
        <small class="text-body-secondary">Replaces <code>frmNewItemType.frm</code> ("Item Group")</small>
    </div>
    <a class="btn btn-primary" asp-action="Create">New Item Type</a>
</div>

<form method="get" asp-action="Index" class="mb-3">
    <div class="input-group" style="max-width: 28rem;">
        <input type="search" name="search" value="@Model.SearchTerm" class="form-control"
               placeholder="Search item types" aria-label="Search" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrEmpty(Model.SearchTerm))
        {
            <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="sc-grid-wrapper">
        <table class="table table-sm table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th scope="col">Name of Item Type</th>
                    <th scope="col">Item Group</th>
                    <th scope="col">Short Name</th>
                    <th scope="col" class="sc-numeric">Items</th>
                    <th scope="col" class="text-end" style="width: 12rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Results.Items.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-body-secondary py-4">No item types found.</td></tr>
                }
                else
                {
                    @foreach (var row in Model.Results.Items)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td class="text-body-secondary">@(row.Group ?? "—")</td>
                            <td class="text-body-secondary">@(row.ShortName ?? "—")</td>
                            <td class="sc-numeric">@row.ItemCount</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@row.Id">Edit</a>
                                <form method="post" class="d-inline" asp-action="Delete" asp-route-id="@row.Id"
                                      onsubmit="return confirm('Are you sure to Delete?');">
                                    @* Deletion is blocked server-side when items are still classified
                                       under this type; the button is disabled here as a courtesy. *@
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            @(row.ItemCount > 0 ? "disabled" : "")
                                            title="@(row.ItemCount > 0 ? $"{row.ItemCount} item(s) use this type" : "Delete")">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <partial name="_Pager" model="@(new PagerViewModel
                                        {
                                            PageNumber = Model.Results.PageNumber,
                                            TotalPages = Model.Results.TotalPages,
                                            TotalCount = Model.Results.TotalCount,
                                            BasePath = Url.Action("Index")!,
                                            RouteValues = new Dictionary<string, string?> { ["search"] = Model.SearchTerm },
                                        })" />
    </div>
</div>
